# Шаблон переменных окружения. Скопируйте в .env.local и заполните значения.
#   cp .env.example .env.local
#
# .env.local в .gitignore и НИКОГДА не коммитится. Значения для прода
# лежат в панели Railway; для локальной разработки заведите свою БД.

# ── Обязательные (без них сервер не стартует) ────────────────────────────────

# Секрет для подписи сессионных JWT. Любая длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Строка подключения к PostgreSQL (Neon).
# ВАЖНО: db.js сам убирает «-pooler.» из хоста — пул Neon (pgbouncer,
# transaction mode) не держит сессионные переменные, а на них построен RLS.
# Подробности — docs/session-log-2026-07-13.md, раздел 6.
DATABASE_URL=

# ── Необязательные ───────────────────────────────────────────────────────────

# Явный прямой (non-pooled) эндпоинт, если хост не следует конвенции Neon.
# Обычно не нужен: db.js выводит его из DATABASE_URL автоматически.
DATABASE_URL_DIRECT=

# Тенант платформы — его владелец видит консоль оператора (/admin.html).
# В production ОБЯЗАТЕЛЕН: без него сервер не стартует.
# По умолчанию в development: 00000000-0000-0000-0000-000000000001
PLATFORM_TENANT_ID=

# Порт HTTP-сервера. По умолчанию: 3000
PORT=

# Часовой пояс для расчётов «сегодня»/границ месяца на бэкенде.
# По умолчанию: Asia/Tashkent (Узбекистан, UTC+5, без перехода на летнее время).
TZ=

# Публичный URL приложения (используется в ссылках).
APP_URL=

# Telegram: приём заявок с лендинга. Обе переменные нужны вместе.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEAD_CHAT_ID=

# Cloudflare R2 (фото костюмов). Если не задано — файлы пишутся на диск (uploads/).
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public URL — публичный домен бакета (r2.dev или свой), без него фото отдаются через /api/media.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=
# Алиасы R2_* тоже принимаются (R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, R2_PUBLIC_URL).

# Отключить лимит попыток входа. Только локальная отладка: RATE_LIMIT_DISABLED=true
RATE_LIMIT_DISABLED=
